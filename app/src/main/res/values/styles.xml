<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar" />
    <!-- Dark splash color while Chrome starts, so there is no white flash -->
    <style name="LauncherTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/splash</item>
        <item name="android:statusBarColor">@color/splash</item>
        <item name="android:navigationBarColor">@color/splash</item>
    </style>
</resources>
